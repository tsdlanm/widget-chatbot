{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "CONVEX_DEPLOY_KEY",
    "CLERK_SECRET_KEY",
    "ALLOWED_EMAILS",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_CLERK_SIGN_IN_URL",
    "NEXT_PUBLIC_CLERK_SIGN_UP_URL",
    "NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL",
    "NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL",
    "NEXT_PUBLIC_CONVEX_URL",
    "NEXT_PUBLIC_WIDGET_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "embed#build": {
      "cache": false
    },
    "web#build": {
      "dependsOn": ["^build", "@workspace/backend#deploy"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "widget#build": {
      "dependsOn": ["^build", "embed#build", "@workspace/backend#deploy"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "@workspace/backend#deploy": {
      "inputs": ["convex/**"],
      "outputs": ["convex/_generated/**"]
    },
    "lint": { "dependsOn": ["^lint"] },
    "format": { "dependsOn": ["^format"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "widget#dev": {
      "dependsOn": ["embed#build"]
    }
  }
}